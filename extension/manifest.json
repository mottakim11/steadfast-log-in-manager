{
  "manifest_version": 3,
  "name": "Steadfast Auto Login Manager",
  "version": "1.0.0",
  "description": "Enterprise one-click secure auto login assistant for Steadfast Courier moderator portal.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Steadfast Auto Login",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "privacy"
  ],
  "host_permissions": [
    "https://steadfast.com.bd/*",
    "https://www.steadfast.com.bd/*",
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://steadfast.com.bd/moderator/login*",
        "https://www.steadfast.com.bd/moderator/login*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
